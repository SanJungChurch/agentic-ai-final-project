LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: local LLM through Ollama. Use this for Qwen3:4b.
# Run first: ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional: Kakao Local API REST key for real place search.
# https://developers.kakao.com/docs/latest/en/local/dev-guide
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Optional: command for an external ShowUI runner.
# The runner should read a JSON task from stdin and print ReservationResult JSON to stdout.
SHOWUI_RUNNER_COMMAND=
SHOWUI_RESERVATION_TARGET=
SHOWUI_GRADIO_SOURCE=showlab/ShowUI
SHOWUI_LOCAL_MODEL=showlab/ShowUI-2B
SHOWUI_MAX_PIXELS=602112

# Optional: Google Workspace OAuth desktop client.
# Download an OAuth Desktop client JSON from Google Cloud Console and place it here.
GOOGLE_OAUTH_CLIENT_FILE=credentials/google_oauth_client.json
GOOGLE_WORKSPACE_TOKEN_FILE=credentials/google_workspace_token.json
