GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Kakao Local API REST key for real place search.
# https://developers.kakao.com/docs/latest/en/local/dev-guide
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Optional: command for an external ShowUI runner.
# The runner should read a JSON task from stdin and print ReservationResult JSON to stdout.
SHOWUI_RUNNER_COMMAND=
SHOWUI_RESERVATION_TARGET=
SHOWUI_GRADIO_SOURCE=showlab/ShowUI
SHOWUI_LOCAL_MODEL=showlab/ShowUI-2B
SHOWUI_MAX_PIXELS=602112
